# Proyectos nativos generados por `expo prebuild` (se regeneran, no se versionan).
# OJO: con barra inicial, para que aplique SOLO a la raíz. Sin ella, el patrón matchea
# cualquier carpeta "android" del árbol e ignoraba modules/chafon-h103/android/, dejando
# fuera del repo el build.gradle, el AndroidManifest.xml y el .aar del SDK Chafon — sin
# esos archivos el módulo nativo ni siquiera es detectado por el autolinking de Expo.
/android/
/ios/

# Salida de compilación del módulo nativo local (el código fuente sí se versiona).
modules/*/android/build/
modules/*/android/.cxx/

.env
.env.*
!.env.example
*.log
.DS_Store

# Material de referencia del fabricante y proyectos externos: viven fuera de este repo
# (C:\NeoInventarios\...), se listan por si alguna vez se copian dentro del árbol.
Downloads/
NeoMobile-main/

