{
  "expo": {
    "name": "Chafon Stock",
    "slug": "chafon-stock",
    "version": "0.1.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "scheme": "chafonstock",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.example.chafonstock",
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "statusBar": {
      "barStyle": "dark-content",
      "translucent": true
    },
    "navigationBar": {
      "barStyle": "dark-content",
      "translucent": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
