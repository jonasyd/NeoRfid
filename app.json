{
  "expo": {
    "name": "Chafon Stock",
    "slug": "chafon-stock",
    "version": "0.1.0",
    "jsEngine": "hermes",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#022449"
    },
    "orientation": "portrait",
    "scheme": "chafonstock",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.example.chafonstock",
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#022449"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
